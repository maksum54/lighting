<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- App.cs memakai System.Windows.Media.Imaging (BitmapImage utk ikon Ribbon) -->
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LuxoraRevit</AssemblyName>
    <RootNamespace>LuxoraRevit</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- RevitAPI tidak boleh ikut tersalin ke folder output -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Add-in dimuat oleh Revit, bukan dijalankan sebagai aplikasi: .deps.json tidak dipakai
         dan hanya jadi berkas nyasar di folder Addins. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Output ditaruh di revit/bin/... (bukan revit/src/bin/...) agar cocok dgn build.ps1 & README. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\bin\</BaseOutputPath>
    <!-- RevitAPI menandai sebagian anggota lama sebagai obsolete; jangan gagalkan build karenanya. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
  </PropertyGroup>

  <!--
    RevitAPI.dll / RevitAPIUI.dll TIDAK di-redistribusi; keduanya diambil dari instalasi Revit.
    Folder dicari berurutan: properti/variabel RevitInstallPath → Program Files (64-bit) →
    Program Files → path default. Semua dinormalkan agar selalu berakhir dgn "\", karena
    tanpa itu HintPath menjadi "...Revit 2025RevitAPI.dll" dan referensi gagal ditemukan.
  -->
  <PropertyGroup>
    <!-- -p:RevitInstallPath=... datang sebagai global property yang tak bisa ditimpa dari dalam
         proyek, jadi hasil normalisasinya disimpan di properti terpisah. -->
    <RevitInstallDir Condition="'$(RevitInstallPath)' != ''">$([MSBuild]::EnsureTrailingSlash('$(RevitInstallPath)'))</RevitInstallDir>

    <RevitApiDir Condition="'$(RevitApiDir)' == '' And '$(RevitInstallDir)' != '' And Exists('$(RevitInstallDir)RevitAPI.dll')">$(RevitInstallDir)</RevitApiDir>
    <RevitApiDir Condition="'$(RevitApiDir)' == '' And '$(ProgramW6432)' != '' And Exists('$(ProgramW6432)\Autodesk\Revit $(RevitVersion)\RevitAPI.dll')">$(ProgramW6432)\Autodesk\Revit $(RevitVersion)\</RevitApiDir>
    <RevitApiDir Condition="'$(RevitApiDir)' == '' And '$(ProgramFiles)' != '' And Exists('$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPI.dll')">$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\</RevitApiDir>
    <RevitApiDir Condition="'$(RevitApiDir)' == '' And Exists('C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll')">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitApiDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(RevitApiDir)' != ''">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Gagal lebih awal dgn pesan yang jelas, bukan ratusan error CS0246 "Autodesk not found". -->
  <Target Name="CekRevitApi" BeforeTargets="BeforeBuild">
    <Error Condition="'$(RevitApiDir)' == ''"
           Text="RevitAPI.dll tidak ditemukan. Pasang Autodesk Revit $(RevitVersion), atau build dengan: dotnet build -p:RevitInstallPath=&quot;C:\Program Files\Autodesk\Revit $(RevitVersion)&quot; (bisa juga -p:RevitVersion=2024)." />
    <Error Condition="'$(RevitApiDir)' != '' And !Exists('$(RevitApiDir)RevitAPIUI.dll')"
           Text="RevitAPIUI.dll tidak ada di '$(RevitApiDir)'. Pastikan folder tsb. adalah folder instalasi Revit yang berisi RevitAPI.dll DAN RevitAPIUI.dll." />
    <Message Importance="high" Text="Luxora: RevitAPI dari $(RevitApiDir)" />
  </Target>

  <ItemGroup>
    <None Include="..\LuxoraRevit.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Luxora32.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Luxora16.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
